# 复制为 .env 使用（.env 已被 gitignore）
# DeepSeek(OpenAI 兼容;官方文档 2026-10:https://api.deepseek.com)
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-flash
# DeepSeek 默认开启 thinking,这里显式关闭,保证严格 JSON 输出、延迟可控。
# 换回 vLLM/Qwen 时改成:{"chat_template_kwargs": {"enable_thinking": false}}
LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=D:\path\to\rag-qa\data\cache\hf

# 检索策略: hybrid=v0.2 定版默认(BM25+RRF) | vector=v0.1 纯向量 | rerank=v0.3(需 GPU)
RETRIEVER=hybrid
HYBRID_CANDIDATES=20
RRF_K=60
# 误拒兜底:首轮判拒后用更大的 k 二次检索重答(0=关闭;不要大于 HYBRID_CANDIDATES)
RETRY_K=20
