# Python
__pycache__/
*.py[cod]
.venv/
venv/

# pytest 临时产物（--basetemp=.pytest_tmp 应对受限环境的系统临时目录权限）
.pytest_cache/
.pytest_tmp/

# 环境与密钥
.env

# 数据与模型缓存（语料原始文件视情况放开）
data/chroma/
data/cache/
models/

# 切块对比实验产物（v0.5 对比用，不入库；现役索引只需 chunks.jsonl）
data/chunks/chunks_fixed.jsonl
data/chunks/chunks_pc*.jsonl

# 评估产物:只入库 summary.json(可复算),原始 records / 日志 / 检索中间件不入库
eval/runs/*/records.jsonl
eval/runs/retrieval_check/
eval/runs/*.log
eval/runs/pilot*/

# IDE / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db
